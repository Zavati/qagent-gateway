{
	"name": "qagent-gateway",
	"compatibility_date": "2026-01-14",
	"main": "src/index.js",
	"vars": {
		// Environment
		"ENVIRONMENT": "development",
		// AI Engine (provider default)
		"AI_PROVIDER": "openai",
		"AI_CONFIG_MODE": "account_preferred",
		"AI_CREDENTIALS_ACTIVE_KEY_VERSION": "v1",
		"GENERATE_TESTS_MODEL": "gpt-4o-mini",
		"AUTOFILL_MODEL": "gpt-4o-mini",
		"OPENAI_TIMEOUT_MS": "90000",
		// Rate limit simples (por token): 20 req / 60s
		"RATE_LIMIT_WINDOW_MS": "90000",
		"RATE_LIMIT_MAX": "200",
		// Limite de payload (bytes)
		"MAX_BODY_BYTES": "250000",
		// Migração de credencial (BE-3002)
		"ALLOW_LEGACY_LICENSE_TOKEN": "true",
		"LEGACY_TOKEN_MIGRATION_UNTIL": "",
		"MIGRATION_REQUIRE_CLIENTKEY_TENANTS": "",
		"MIGRATION_REQUIRE_CLIENTKEY_COHORTS": "",
		// Métricas de adoção (BE-3003)
		"MIGRATION_METRICS_ENABLED": "true",
		// Webhooks (BE-2001, BE-2002)
		"CLIENT_KEY_MODE": "test",
		"EMAIL_DISPATCH_WEBHOOK_URL": ""
	},
	"d1_databases": [
		{
			"binding": "qagent_dev",
			"database_name": "qagent-dev",
			"database_id": "37f3331a-a3ea-4176-a010-901bcd8d19b8",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "QAGENT_KV",
			"id": "64fb68d7aa714061a3082d259df3cdff"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}