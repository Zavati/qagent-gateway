{
	"name": "qagent-gateway",
	"compatibility_date": "2026-01-14",
	"main": "src/index.js",
	"secrets": {
		"required": ["CATALOG_QUERY_HMAC_SECRET", "RUNNER_CONTROL_HMAC_SECRET"]
	},
	"services": [
		{
			"binding": "CATALOG_QUERY_SERVICE",
			"service": "qagent-catalog"
		},
		{
			"binding": "TEST_REGISTRY_SERVICE",
			"service": "qagent-test-registry"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "RUN_QUEUE",
				"queue": "qagent-run-requests"
			}
		]
	},
	"vars": {
		// Environment
		"ENVIRONMENT": "development",
		// AI Engine (provider default)
		"AI_PROVIDER": "openai",
		"AI_CONFIG_MODE": "account_preferred",
		"AI_CREDENTIALS_ACTIVE_KEY_VERSION": "v1",
		"GENERATE_TESTS_MODEL": "gpt-4o-mini",
		"AUTOFILL_MODEL": "gpt-4o-mini",
		"OPENAI_TIMEOUT_MS": "90000",
		// Rate limit simples (por token): 20 req / 60s
		"RATE_LIMIT_WINDOW_MS": "90000",
		"RATE_LIMIT_MAX": "200",
		// Limite de payload (bytes)
		"MAX_BODY_BYTES": "250000",
		// Migração de credencial (BE-3002)
		"ALLOW_LEGACY_LICENSE_TOKEN": "true",
		"LEGACY_TOKEN_MIGRATION_UNTIL": "",
		"MIGRATION_REQUIRE_CLIENTKEY_TENANTS": "",
		"MIGRATION_REQUIRE_CLIENTKEY_COHORTS": "",
		// Métricas de adoção (BE-3003)
		"MIGRATION_METRICS_ENABLED": "true",
		// Webhooks (BE-2001, BE-2002)
		"CLIENT_KEY_MODE": "test",
		"OBSERVATION_GRANT_TTL_SECONDS": "120",
		"EMAIL_DISPATCH_WEBHOOK_URL": "",
		// Foundation 07.5.12-A - internal Catalog Query API proxy
		"CATALOG_QUERY_BASE_URL": "https://api.apiqagent.com",
		"CATALOG_QUERY_TIMEOUT_MS": "10000",
		// Foundation 07.6.5-C - internal Test Registry persistence
		"TEST_REGISTRY_TIMEOUT_MS": "10000",
		"TEST_REGISTRY_PERSIST_RETRIES": "1",
		// Foundation 07.7.3 - internal Runner Control HMAC clock skew
		"RUNNER_CONTROL_MAX_SKEW_SECONDS": "60"
	},
	"d1_databases": [
		{
			"binding": "QAGENT_DB",
			"database_name": "qagent-dev",
			"database_id": "37f3331a-a3ea-4176-a010-901bcd8d19b8",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "QAGENT_KV",
			"id": "64fb68d7aa714061a3082d259df3cdff"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
