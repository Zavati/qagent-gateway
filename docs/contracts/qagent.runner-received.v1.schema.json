{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qagent.runner-received.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "executionPlanId", "runtimeSnapshotId"],
  "properties": {
    "contractVersion": { "const": "qagent.runner-received.v1" },
    "executionPlanId": { "type": "string", "pattern": "^xplan_[A-Za-z0-9_-]{8,220}$" },
    "runtimeSnapshotId": { "type": "string", "pattern": "^rts_[A-Za-z0-9_-]{8,220}$" }
  }
}
