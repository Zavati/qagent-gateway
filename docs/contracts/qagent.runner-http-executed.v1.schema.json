{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qagent.runner-http-executed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "attemptId", "leaseToken", "runtimePlanHash", "requestCount", "responseCount", "networkErrorCount", "timeoutCount", "redirectCount", "durationMs"],
  "properties": {
    "contractVersion": { "const": "qagent.runner-http-executed.v1" },
    "attemptId": { "type": "string" },
    "leaseToken": { "type": "string" },
    "runtimePlanHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requestCount": { "type": "integer", "minimum": 0, "maximum": 50 },
    "responseCount": { "type": "integer", "minimum": 0, "maximum": 50 },
    "networkErrorCount": { "type": "integer", "minimum": 0, "maximum": 50 },
    "timeoutCount": { "type": "integer", "minimum": 0, "maximum": 50 },
    "redirectCount": { "type": "integer", "minimum": 0, "maximum": 150 },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
    "responseStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response2xxCount": { "type": "integer", "minimum": 0, "maximum": 50 },
        "response3xxCount": { "type": "integer", "minimum": 0, "maximum": 50 },
        "response4xxCount": { "type": "integer", "minimum": 0, "maximum": 50 },
        "response5xxCount": { "type": "integer", "minimum": 0, "maximum": 50 }
      }
    },
    "primaryDiagnostic": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scenarioId", "statusCode", "errorCode", "errorCategory", "errorName", "causeCode"],
          "properties": {
            "kind": { "enum": ["NETWORK_ERROR", "TIMEOUT", "HTTP_RESPONSE"] },
            "scenarioId": { "type": ["string", "null"] },
            "statusCode": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
            "errorCode": { "type": ["string", "null"] },
            "errorCategory": { "type": ["string", "null"], "enum": ["DNS", "CONNECT", "TLS", "RESET", "ABORT", "FETCH", "UNKNOWN", "TIMEOUT", null] },
            "errorName": { "type": ["string", "null"] },
            "causeCode": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
