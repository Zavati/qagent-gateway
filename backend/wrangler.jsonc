{
  "name": "qagent-gateway",
  "compatibility_date": "2026-01-19",
  "main": "src/index.js",
  "vars": {
    // Tokens válidos (dev). Em produção, migre para KV/DB.
    "OPENAI_TIMEOUT_MS": "90000",
    // Rate limit simples (por token): 20 req / 60s
    "RATE_LIMIT_WINDOW_MS": "90000",
    "RATE_LIMIT_MAX": "200",
    // Limite de payload (bytes)
    "MAX_BODY_BYTES": "250000"
  }
}