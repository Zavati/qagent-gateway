# QAgent Gateway - local development variables
# Copy this file to .dev.vars and fill values locally.
# Never commit .dev.vars.

AI_PROVIDER=openai
AI_CONFIG_MODE=account_preferred
AI_CREDENTIALS_ACTIVE_KEY_VERSION=v1
AI_CREDENTIALS_KEY_V1=
QAGENT_SECRETS_ACTIVE_KEY_VERSION=v1
QAGENT_SECRETS_KEY_V1=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_API_VERSION=v1
AI_MAX_RETRY_WAIT_MS=2500
AI_RETRY_BASE_DELAY_MS=500
AI_RETRY_MAX_DELAY_MS=2000
GENERATE_TESTS_MODEL=gpt-4o-mini
AUTOFILL_MODEL=gpt-4o-mini
QAGENT_LICENSE_TOKENS=
QAGENT_ADMIN_TOKENS=
WEBHOOK_SIGNING_SECRET=
MAILERSEND_API_KEY=
EMAIL_DISPATCH_WEBHOOK_URL=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_MAX_SKEW_SEC=300
SESSION_SECRET=
